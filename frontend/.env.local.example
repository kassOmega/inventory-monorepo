# Backend API base URL
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# Web Push VAPID public key (must match the backend's VAPID_PUBLIC_KEY)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BJlyIPasYpzqihbUZwAvqWvjjqyGQ4xOd8NgbF1bWusj4fhue_YF-FH5XuWGVwadwaCeYPPtu1GKEVwCyA-sVK0

# Optional: set to "true" to register the service worker + enable push while
# developing locally (npm run dev). Needed to see the notification permission
# prompt in development — without it dev never registers a worker.
# NEXT_PUBLIC_ENABLE_PUSH=true

# Optional: set to "true" to build + register the service worker in `next dev`
# so offline navigation/queueing can be tested locally. Off by default: a dev SW
# can serve stale chunks across hot reloads. Restart the dev server after
# changing this, and unregister the worker (DevTools > Application) when done.
# NEXT_PUBLIC_ENABLE_PWA=true

# Optional: endpoint for lightweight install analytics events (POST JSON).
# Events are also dispatched in the browser as a `kass:install` CustomEvent,
# so an existing analytics tool can listen without this endpoint.
# NEXT_PUBLIC_INSTALL_ANALYTICS_ENDPOINT=
