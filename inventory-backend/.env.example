# ---------------------------------------------------------------------------
# SECRETS MANAGEMENT
# ---------------------------------------------------------------------------
# This file is a TEMPLATE ONLY. Never commit real secrets. In deployed
# environments inject secrets through the host's environment variables or a
# secrets manager (Render secret files, AWS Secrets Manager, GCP Secret
# Manager, GitHub Actions secrets, Docker secrets, …) rather than writing them
# to a .env file on disk. Rotate JWT_SECRET and VAPID keys regularly; rotating
# JWT_SECRET invalidates every existing user session (acceptable during a
# security rotation).
#
# Local-only quick start (gitignored `inventory-backend/.env`):
#   JWT_SECRET:        openssl rand -hex 64
#   VAPID keys:        npx web-push generate-vapid-keys
#   GEMINI_API_KEY:    create a new key at https://aistudio.google.com/apikey
# ---------------------------------------------------------------------------

# PostgreSQL connection string. Replace <db-user>/<db-password>/<db-host> at
# deploy time — do NOT paste a real password into this template.
# `connection_limit` caps the Prisma pool size so requests aren't queued behind
# a bottlenecked pool (tune up/down for your host's resources).
DATABASE_URL="postgresql://<db-user>:<db-password>@<db-host>:5432/inventory_db?schema=public&connection_limit=5"

# JWT signing secret — REQUIRED. Use a strong random value of at least 64
# characters. Generate one with:  openssl rand -hex 64
JWT_SECRET=""

# Web Push (VAPID) keys — generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@inventory.com"

# --- Gemini AI Business Advisor ---
# API key from https://aistudio.google.com/apikey (provision a fresh key).
GEMINI_API_KEY=""
# Fast model used for the streaming AI coach chat and quick alerts.
GEMINI_FAST_MODEL=gemini-3.5-flash
# Deep model used for predictive forecasting and weekly reports.
GEMINI_PRO_MODEL=gemini-3.5-flash
# Optional fallback used when the fast model is overloaded/unavailable.
# Defaults to GEMINI_PRO_MODEL when omitted.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash
# Set to true to enable the scheduled weekly insight generation (cron).
AI_ENABLED=true
# Per-user daily AI query quota shared across /ai/chat and /ai/forecast.
AI_DAILY_QUOTA=15
# Runs the Autonomous Owner Agent cron sweep (every 30 min) for orgs in AUTONOMOUS mode.
AI_AGENT_CRON_ENABLED=false
# Auto-generates a PurchaseOrderDraft per org (every 2h) when items drop below
# their reorder threshold. Requires GEMINI_API_KEY for supplier/notes refinement;
# falls back to a deterministic draft when the key is absent.
PO_DRAFT_AUTOGEN_ENABLED=false

# --- Account verification (KYC) ---
# Directory where uploaded verification documents are stored (relative to the
# backend working directory unless absolute).
UPLOAD_DIR=uploads
# A verification is permanently BLOCKED after this many admin rejections
# (fraudulent / illegitimate document submissions).
VERIFICATION_MAX_SCAM_ATTEMPTS=4

# --- Per-vertical separation ---
# Controllers decorated with @Vertical(...) are ALWAYS restricted to the matching
# business type (enforced in code — there is no env switch): a HOSPITALITY or
# RETAIL organization cannot read SERVICE / MANUFACTURING / CAR_WASH module data
# even if its role happens to hold the permission key (role templates are shared
# across verticals). Mismatches get a 403 "This feature is not available for your
# industry.". See src/common/guards/vertical/vertical.guard.ts.

# --- Deployment / security ---
# Server port (most hosts inject PORT automatically)
PORT=3000

# Comma-separated list of allowed browser origins (your frontend URL).
# Production serves both apps from one origin (https://inventory.ethioterratrade.com),
# so CORS is usually irrelevant there; keep the local dev origin for `next dev`.
# e.g. CORS_ORIGIN="https://inventory.ethioterratrade.com,https://app.yourdomain.com"
CORS_ORIGIN=http://localhost:3001

# Auth cookie flags.
# COOKIE_SECURE=true when serving over HTTPS (production).
# COOKIE_SAME_SITE=lax when frontend + backend share the same site;
# use "none" only when they are on different domains (requires HTTPS).
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# --- Proxy trust (client IP resolution for lockout / rate limits) ---
# Enable ONLY when the backend sits behind a trusted reverse proxy/load balancer
# (Render, Cloudflare, nginx, …). When disabled, X-Forwarded-For is ignored so
# a direct client cannot spoof its IP.
TRUST_PROXY=false
# Comma-separated proxy peer IPs/subnets (or proxy-addr keywords such as
# loopback) that are allowed to set X-Forwarded-For.
# Example behind nginx on the same host: TRUSTED_PROXY_CIDRS=loopback
TRUSTED_PROXY_CIDRS=loopback
